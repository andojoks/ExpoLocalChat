{
  "expo": {
    "name": "Expert Learner",
    "slug": "QuestionBankChat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "expertlearner",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.expertlearner.app",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.expertlearner.app",
      "adaptiveIcon": {
        "backgroundColor": "#0548E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0548E8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0548E8"
        }
      ],
      "expo-sqlite",
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": "production",
          "forceCxx20": true,
          "enableOpenCLAndHexagon": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "react-native-quick-crypto"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "andojoks",
    "extra": {
      "router": {},
      "apiBaseUrl": "https://www.theexpertlearner.com",
      "aboutUrl": "https://www.theexpertlearner.com/about",
      "privacyUrl": "https://www.theexpertlearner.com/privacy",
      "termsUrl": "https://www.theexpertlearner.com/terms",
      "shareUrl": "https://www.theexpertlearner.com",
      "googleWebClientId": "YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com",
      "googleIosClientId": "YOUR_GOOGLE_IOS_CLIENT_ID.apps.googleusercontent.com",
      "googleAndroidClientId": "YOUR_GOOGLE_ANDROID_CLIENT_ID.apps.googleusercontent.com",
      "eas": {
        "projectId": "1b7f104e-9480-4fbd-9636-0fe0d088ed5d"
      }
    }
  }
}
