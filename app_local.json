{
  "expo": {
    "name": "Expert Learner",
    "slug": "QuestionBankChat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "expertlearner",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.expertlearner.app",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.expertlearner.app",
      "adaptiveIcon": {
        "backgroundColor": "#0548E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.theexpertlearner.com",
              "pathPrefix": "/oauthredirect"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0548E8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0548E8"
        }
      ],
      "expo-sqlite",
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": "production",
          "forceCxx20": true,
          "enableOpenCLAndHexagon": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "react-native-quick-crypto"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "andojoks",
    "extra": {
      "router": {},
      "apiBaseUrl": "http://192.168.1.120:3000",
      "aboutUrl": "http://192.168.1.120:3000/about",
      "privacyUrl": "http://192.168.1.120:3000/privacy",
      "termsUrl": "http://192.168.1.120:3000/terms",
      "shareUrl": "http://192.168.1.120:3000",
      "googleWebClientId": "462865214843-bjvlmldsfdl0tgbgliobo23agetva2ii.apps.googleusercontent.com",
      "googleIosClientId": "YOUR_GOOGLE_IOS_CLIENT_ID.apps.googleusercontent.com",
      "googleAndroidClientId": "462865214843-64850e68gmetfnfdb75qjgrgsrak43no.apps.googleusercontent.com",
      "googleOAuthRedirectUrl": "https://www.theexpertlearner.com/oauthredirect"
    }
  }
}
